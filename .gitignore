# Generated caches (OSM graph, HMM map index, state, render, routes, weather).
# All of it lives in one directory now; see config.CACHE_DIR.
cache/
# Belt and braces: the graph pickle is ~260 MB, so never commit a stray one.
*.pkl

# Ride data (personal GPS traces)
rides/*.csv

# Output images (generated by the script)
*.png

# GPX staging area for the Garmin sync (not committed)
incoming/

# Keep sample output tracked
!sample_output/*.png

# Python
__pycache__/
build/
*.egg-info/
*.pyc

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Development artifacts
coords_*.csv

# Claude Code (keep committed skills, ignore local settings/worktrees)
.claude/*
!.claude/skills/
memory/

# Node / Playwright
node_modules/
test-results/
playwright-report/

# OS
.DS_Store
Thumbs.db

# Local virtualenv (WSL)
.venv/
